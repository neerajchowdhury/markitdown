# MarkItDesk Environment Variables
# Copy to .env and adjust as needed

# Workspace and output directories (default: ./workspace and ./output)
WORKSPACE_ROOT=./workspace
OUTPUT_ROOT=./output

# Security limits
MAX_FILE_MB=100

# Feature flags (all disabled by default for security)
ALLOW_PLUGINS=false
ALLOW_REMOTE_URLS=false
ALLOW_AI_ENRICHMENT=false